rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Optional: mark admin users via custom claims (request.auth.token.admin == true)
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    
    // Users collection
    match /users/{userId} {
      // Public can read basic user data (used for leaderboard).
      // Writes are still restricted to the user/admin.
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }
    
    // Public-safe booked slots for availability UI (no names/phones).
    // Written by Cloud Functions; readable by everyone.
    match /bookedSlots/{bookingId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Bookings collection (private)
    match /bookings/{bookingId} {
      // Only signed-in users can create bookings (prevents public spam/writes).
      allow create: if isSignedIn()
        && request.resource.data.timeSlot is string
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.userId == request.auth.uid;
      
      // Users can read their own bookings; admins can read all.
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      // Only admins can edit/delete bookings (keeps integrity simple).
      allow update, delete: if isAdmin();
    }
    
    // Settings collection - anyone can read and write (for admin panel)
    // In production, you'd want to restrict write access to admin users only
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

